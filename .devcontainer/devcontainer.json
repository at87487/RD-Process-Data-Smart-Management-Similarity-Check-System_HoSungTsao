{
  "name": "R&D Experiment Data Smart Management System",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": {
      "label": "Gradio App",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },

  // 清洗並安裝正確套件
  "postCreateCommand": "rm -rf venv && python -m venv venv && ./venv/bin/pip install --upgrade pip && ./venv/bin/pip install gradio pandas numpy matplotlib",

  // ❌ 刪除原本的 postStartCommand 背景執行
  // ⭕ 改用 settings：讓終端機一打開就自動進入虛擬環境，並把右上角的「播放按鈕」修正為使用虛擬環境
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
